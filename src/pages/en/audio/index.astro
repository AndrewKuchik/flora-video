---
import Base from '../../../layouts/Base.astro';
---
<Base title="Flora Sound Records · audio" lang="en" theme="theme-audio">

<main class="chooser fx">
  <nav class="langbar" aria-label="Language">
    <a href="../" class="back">← Services</a>
    <a href="../../ru/audio/">RU</a>
    <a href="../../lv/audio/">LV</a>
    <a href="../../en/audio/" class="active">EN</a>
  </nav>
  <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(60 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(120 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(180 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(240 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(300 24 24)"/>
      <circle cx="24" cy="24" r="2.7"/>
    </g>
  </svg>
  <div class="brand">Flora Sound Records · Riga</div>
  <h1>Audio</h1>
  <nav class="menu-grid big">
    <a href="recording/"><span class="mt">Recording</span><span class="md">Vocals, instruments, voiceover</span></a>
    <a href="mixing/"><span class="mt">Mixing & mastering</span><span class="md">Mix and final sound</span></a>
    <a href="rental/"><span class="mt">Studio rental</span><span class="md">An hour with a sound engineer</span></a>
    <a href="lessons/"><span class="mt">Lessons</span><span class="md">Vocals, guitar, beatmaking</span></a>
  </nav>
  <p class="chooser-note">Recording, mixing, mastering, rental and lessons. Call and book: every day 10:00–22:00, +371 27 775 842.</p>
</main>


<Base title="Flora Creative Studio · foto un video" lang="lv">


<main class="chooser fx">
  <nav class="langbar" aria-label="Valoda">
    <a href="../" class="back">← Pakalpojumi</a>
    <a href="../../ru/video/">RU</a>
    <a href="../../lv/video/" class="active">LV</a>
    <a href="../../en/video/">EN</a>
  </nav>
  <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(60 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(120 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(180 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(240 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(300 24 24)"/>
      <circle cx="24" cy="24" r="2.7"/>
    </g>
  </svg>
  <div class="brand">Flora Creative Studio · Rīga</div>
  <h1>Video</h1>
  <nav class="menu-grid big">
    <a href="../clip/"><span class="mt">Mūzikas videoklips</span><span class="md">Pilnā ciklā vai pēc jūsu idejas</span></a>
    <a href="../business/"><span class="mt">Video biznesam</span><span class="md">Promo, produkts, reklāma</span></a>
    <a href="../events/"><span class="mt">Pasākumi</span><span class="md">Pasākumu filmēšana, highlight klips</span></a>
    <a href="../smm/"><span class="mt">SMM / Reels</span><span class="md">Vertikāli klipi, ikmēneša saturs</span></a>
  </nav>
</main>


  <div class="fc-brand">Flora Creative Studio · Rīga</div>
  <div class="fc-lines">
    <a href="tel:+37127775842">+371 27 775 842</a>
    <span class="sep">·</span>
    <a href="mailto:info@florasoundrecords.lv">info@florasoundrecords.lv</a>

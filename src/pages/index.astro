---
import Base from '../layouts/Base.astro';
---
<Base title="Flora Creative Studio" lang="en">

<main class="hero fx">
  <div class="flower-wrap"><canvas id="flower" width="480" height="480" aria-hidden="true"></canvas></div>
  <div class="brand brand-lg">Flora Creative Studio</div>
  <div class="city">Rīga</div>

  <ul class="lang-ring" id="langRing" role="listbox" aria-label="Choose language / Izvēlieties valodu / Выберите язык" data-enhance>
    <li><a class="lang-card" role="option" href="en/" data-lang="en" data-enter="tap to enter →" aria-selected="true"><span class="big">EN</span><span class="sub">English</span></a></li>
    <li><a class="lang-card" role="option" href="lv/" data-lang="lv" data-enter="pieskaries, lai atvērtu →" aria-selected="false"><span class="big">LV</span><span class="sub">Latviešu</span></a></li>
    <li><a class="lang-card" role="option" href="ru/" data-lang="ru" data-enter="нажми, чтобы войти →" aria-selected="false"><span class="big">RU</span><span class="sub">Русский</span></a></li>
  </ul>
  <div class="enter-tag" id="enterTag" aria-hidden="true"></div>
</main>


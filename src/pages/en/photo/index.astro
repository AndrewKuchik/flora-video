---
import Base from '../../../layouts/Base.astro';
---
<Base title="Flora Creative Studio · photo" lang="en" theme="theme-photo">

<main class="chooser fx">
  <nav class="langbar" aria-label="Language">
    <a href="../" class="back">← Services</a>
    <a href="../../ru/photo/">RU</a>
    <a href="../../lv/photo/">LV</a>
    <a href="../../en/photo/" class="active">EN</a>
  </nav>
  <svg class="mark" viewBox="0 0 48 48" aria-hidden="true">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(60 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(120 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(180 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(240 24 24)"/>
      <ellipse cx="24" cy="13.6" rx="4.7" ry="8.7" transform="rotate(300 24 24)"/>
      <circle cx="24" cy="24" r="2.7"/>
    </g>
  </svg>
  <div class="brand">Flora Creative Studio · Riga</div>
  <h1>Photo</h1>
  <nav class="menu-grid big">
    <a href="wedding/"><span class="mt">Weddings & events</span><span class="md">Weddings, celebrations, reportage</span></a>
    <a href="commercial/"><span class="mt">Commercial & product</span><span class="md">Product, catalogue, ads</span></a>
    <a href="music/"><span class="mt">Musicians & covers</span><span class="md">Artist promo, track covers</span></a>
    <a href="portrait/"><span class="mt">Business portraits</span><span class="md">Headshots, team, for your site</span></a>
  </nav>
</main>


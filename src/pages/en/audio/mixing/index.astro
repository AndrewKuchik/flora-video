<section>
  <div class="col">
    <div class="sh"><span class="snum">1</span><h2>About the service</h2></div>
    <p class="lead">Mixing and mastering of your track. 40 € per hour, or a fixed price for the task — we'll calculate it by phone. Remote work is possible.</p>
  </div>
</section>
<section>
  <div class="col">
    <div class="sh"><span class="snum">2</span><h2>Prices</h2></div>
    <div class="ptable">
      <div class="prow"><div class="pn">Mixing & mastering</div><div class="pp">40 € per hour</div></div>
      <div class="prow"><div class="pn">Fixed price<small>For a specific track</small></div><div class="pp">on request</div></div>
      <div class="prow"><div class="pn">Remote<small>By track length and number of edits</small></div><div class="pp">on request</div></div>
    </div>
    <ul class="notes">
      <li><b>Remote.</b> The price depends on the track length and number of edits. 2 edits are already included.</li>
      <li><b>Online.</b> I accept sessions and stems; the final check can be done at the studio.</li>
    </ul>
  </div>
</section>
<section>
  <div class="col">
    <div class="sh"><span class="snum">3</span><h2>Calculator</h2></div>
    <div class="calc">
      <div class="crow">
        <div class="cl"><div class="t">Rate</div><div class="s">Mixing & mastering</div></div>
        <div class="ctrl">
          <select id="a-rate" aria-label="Rate">
            <option value="40">Mixing & mastering · 40 €/h</option>
          </select>
          <span class="cprice on" id="p-rate">40 €</span>
        </div>
      </div>
      <div class="crow">
        <div class="cl"><div class="t">Working hours</div></div>
        <div class="ctrl">
          <div class="stepper">
            <button type="button" id="h-minus" aria-label="Fewer hours">−</button>
            <input type="number" id="a-hours" value="3" min="1" max="12" inputmode="numeric" aria-label="Working hours">
            <button type="button" id="h-plus" aria-label="More hours">+</button>
          </div>
        </div>
      </div>
      <div class="total">
        <span class="lab">Approximately</span>
        <span class="val" id="a-total">from …</span>
      </div>
      <p class="fine">Approximate time. A fixed price and remote work are possible.</p>
    </div>
  </div>
</section>
<section>
  <div class="col">
    <div class="sh"><span class="snum">4</span><h2>Terms</h2></div>
    <ul class="cond">
      <li><b>Prices are final,</b> PVN is not added.</li>
      <li><b>Equipment.</b> Professional gear and licensed software.</li>
      <li><b>Booking</b> by phone, open every day 10:00–22:00.</li>
      <li><b>Remote.</b> Order online, final at the studio.</li>
    </ul>
  </div>
</section>
<section class="close">
  <div class="col">
    <p class="cta">Send your session and we'll mix and master the track for release.</p>
    <div class="contacts">
      <div class="who">Flora Sound Records</div>
      <div>Artilerijas iela 40k-4, Riga · every day 10:00–22:00</div>
      <div>Call or WhatsApp: <a href="tel:+37127775842">+371 27 775 842</a></div>
    </div>
  </div>
</section>

<script is:inline>
  (function(){
    var f=function(id){return document.getElementById(id);};
    var body=document.body;
    var fromAttr=body.getAttribute("data-from");
    var FROM=fromAttr?fromAttr+" ":"";
    var LOC=body.getAttribute("data-loc")||"en";
    var hoursEl=f("a-hours"), rateEl=f("a-rate");
    function clampHours(){var v=parseInt(hoursEl.value,10);if(isNaN(v)||v<1)v=1;if(v>12)v=12;hoursEl.value=v;return v;}
    function rate(){return rateEl?parseInt(rateEl.value,10):40;}
    function euro(n){return n.toLocaleString(LOC)+" €";}
    function recalc(){
      var total=clampHours()*rate();
      f("p-rate").textContent=euro(rate());
      f("a-total").textContent=FROM+euro(total);
    }
    f("h-minus").addEventListener("click",function(){hoursEl.value=clampHours()-1;recalc();});
    f("h-plus").addEventListener("click",function(){hoursEl.value=clampHours()+1;recalc();});
    if(rateEl) rateEl.addEventListener("change",recalc);
    hoursEl.addEventListener("input",recalc); hoursEl.addEventListener("change",recalc);
    recalc();
  })();
</script>


